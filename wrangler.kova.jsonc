{
  "$schema": "node_modules/wrangler/config-schema.json",
  // HQ (the personal dashboard) runs as its own Worker so it gets its own
  // URL (https://hq.<account>.workers.dev) with the app at the root path.
  // Deploy with:  npx wrangler deploy -c wrangler.kova.jsonc
  // (run `node build-kova.js` first — it stages the assets into dist-kova/).
  //
  // The KOVA_SYNC KV binding is inserted automatically by the
  // "KOVA sync setup (one-time)" GitHub workflow — do not add it by hand
  // unless the namespace already exists, or deploys will fail.
  "name": "hq",
  "main": "kova-worker.js",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-kova",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
