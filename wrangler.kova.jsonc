{
  "$schema": "node_modules/wrangler/config-schema.json",
  // HQ (the personal dashboard) runs as its own Worker so it gets its own
  // URL (https://hq.<account>.workers.dev) with the app at the root path.
  // Deploy with:  npx wrangler deploy -c wrangler.kova.jsonc
  // (run `node build-kova.js` first — it stages the assets into dist-kova/).
  //
  // Device-sync storage is the SyncStore Durable Object below — it deploys
  // with the Worker itself, so sync needs no extra setup.
  "name": "hq",
  "main": "kova-worker.js",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-kova",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_DO", "class_name": "SyncStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncStore"] }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
