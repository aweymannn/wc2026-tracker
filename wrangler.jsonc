{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wc2026-tracker",
  "main": "worker.js",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  // Device sync lives on the "hq" Worker (Durable Object). This Worker has
  // no SYNC_DO binding, so /api/sync here answers 501 — the legacy
  // /kova.html copy points users to the hq URL for syncing.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
